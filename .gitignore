# FOC - configuracion de Git.

# Directorio de trabajo local (scratch del desarrollador)
/build/

# Binarios generados
/bin/foc
/bin/foc.exe
/bin/focdep
/bin/focdep.exe
/bin/foccount
/bin/foccount.exe
/build/*.exe
/build/foc_tests
/build/foc_stdio_tests
/build/arith
/build/arith.exe
/build/*.log
/build/**/*.log
/lib/*.a
*.o
*.obj
*.s
*.a
*.exe
*.dll
*.so
*.dylib

# Fuentes de ensamblador de las pruebas de integracion (no son artefactos).
!/tests/integration/assembly.s
!/tests/integration/assembly_cpp.S

# Ficheros generados por configure
# (Makefile es mantenido a mano, no generado; por eso se versiona).
/config.status
/config.log

# Resultados de pruebas
/tests/out/*
!/tests/out/.*
*.tmp

# Editores
*.swp
*~

# Sistema
.DS_Store
Thumbs.db

# No ocultar archivos o carpetas con prefijo punto.
!.*
